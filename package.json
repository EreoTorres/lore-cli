{
  "name": "@ereotorres/lore-cli",
  "version": "0.2.0",
  "description": "ADRs you can ask questions to. Zero-config local hybrid search (BM25 + ONNX embeddings) and full lifecycle for Architecture Decision Records, with a built-in MCP server.",
  "type": "module",
  "bin": {
    "lore": "./dist/cli/index.js",
    "lore-cli": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EreoTorres/lore-cli.git"
  },
  "homepage": "https://github.com/EreoTorres/lore-cli#readme",
  "bugs": {
    "url": "https://github.com/EreoTorres/lore-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "adr",
    "architecture-decision-records",
    "adr-tools",
    "rag",
    "semantic-search",
    "vector-search",
    "mcp",
    "model-context-protocol",
    "knowledge-base",
    "documentation",
    "git"
  ],
  "author": "Jose Ernesto Torres Zamora",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@xenova/transformers": "^2.17.2",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
